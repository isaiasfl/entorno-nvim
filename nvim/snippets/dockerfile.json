{
  "Dockerfile para aplicación Node": {
    "prefix": "node",
    "body": [
      "FROM node:${1:24}-alpine",
      "WORKDIR /app",
      "COPY package*.json ./",
      "RUN npm ci",
      "COPY . .",
      "EXPOSE ${2:3000}",
      "CMD [\"npm\", \"start\"]$0"
    ],
    "description": "Dockerfile para aplicación Node"
  },
  "Dockerfile multietapa: compilar con Vite y servir con Nginx": {
    "prefix": "vite",
    "body": [
      "# Etapa 1: compilar",
      "FROM node:${1:24}-alpine AS build",
      "WORKDIR /app",
      "COPY package*.json ./",
      "RUN npm ci",
      "COPY . .",
      "RUN npm run build",
      "",
      "# Etapa 2: servir los estáticos",
      "FROM nginx:alpine",
      "COPY --from=build /app/${2:dist} /usr/share/nginx/html",
      "EXPOSE 80$0"
    ],
    "description": "Dockerfile multietapa: compilar con Vite y servir con Nginx"
  },
  "Dockerfile Nginx con web estática": {
    "prefix": "nginx",
    "body": [
      "FROM nginx:alpine",
      "COPY ${1:./html} /usr/share/nginx/html",
      "EXPOSE 80$0"
    ],
    "description": "Dockerfile Nginx con web estática"
  },
  "Dockerfile para aplicación Python": {
    "prefix": "python",
    "body": [
      "FROM python:${1:3.13}-slim",
      "WORKDIR /app",
      "COPY requirements.txt .",
      "RUN pip install --no-cache-dir -r requirements.txt",
      "COPY . .",
      "CMD [\"python\", \"${2:main.py}\"]$0"
    ],
    "description": "Dockerfile para aplicación Python"
  },
  "Dockerfile Debian con paquetes": {
    "prefix": "debian",
    "body": [
      "FROM debian:${1:trixie}-slim",
      "RUN apt-get update \\\\",
      "    && apt-get install -y --no-install-recommends ${2:curl ca-certificates} \\\\",
      "    && rm -rf /var/lib/apt/lists/*",
      "$0"
    ],
    "description": "Dockerfile Debian con paquetes"
  },
  "Dockerfile Apache con web estática": {
    "prefix": "apache",
    "body": [
      "FROM httpd:${1:2.4}",
      "COPY ${2:./html} /usr/local/apache2/htdocs/",
      "EXPOSE 80$0"
    ],
    "description": "Dockerfile Apache con web estática"
  },
  "Ejecutar como usuario sin privilegios": {
    "prefix": "user",
    "body": [
      "RUN useradd --create-home ${1:app}",
      "USER ${1:app}$0"
    ],
    "description": "Ejecutar como usuario sin privilegios"
  },
  "Comprobación de salud (HEALTHCHECK)": {
    "prefix": "health",
    "body": [
      "HEALTHCHECK --interval=30s --timeout=3s CMD ${1:curl -f http://localhost/ || exit 1}$0"
    ],
    "description": "Comprobación de salud (HEALTHCHECK)"
  },
  "Variables y argumentos de construcción": {
    "prefix": "env",
    "body": [
      "ARG ${1:VERSION}=${2:1.0}",
      "ENV ${3:APP_ENV}=${4:production}$0"
    ],
    "description": "Variables y argumentos de construcción"
  }
}
