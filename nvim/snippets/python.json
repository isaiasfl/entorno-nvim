{
  "Cabecera de ejercicio Python": {
    "prefix": "cab",
    "body": [
      "\"\"\"",
      "${1:Enunciado del ejercicio}",
      "",
      "Autor: ${2:Nombre y apellidos}",
      "\"\"\"",
      "",
      "$0"
    ],
    "description": "Cabecera de ejercicio Python"
  },
  "Bloque principal (if __name__ == \"__main__\")": {
    "prefix": "main",
    "body": [
      "def main() -> None:",
      "    ${1:pass}",
      "",
      "",
      "if __name__ == \"__main__\":",
      "    main()$0"
    ],
    "description": "Bloque principal (if __name__ == \"__main__\")"
  },
  "Función con tipos y docstring": {
    "prefix": "def",
    "body": [
      "def ${1:nombre}(${2:param}: ${3:int}) -> ${4:None}:",
      "    \"\"\"${5:Qué hace la función.}\"\"\"",
      "    ${0:pass}"
    ],
    "description": "Función con tipos y docstring"
  },
  "Clase con constructor": {
    "prefix": "class",
    "body": [
      "class ${1:Nombre}:",
      "    \"\"\"${2:Descripción de la clase.}\"\"\"",
      "",
      "    def __init__(self, ${3:valor}: ${4:int}) -> None:",
      "        self.${3:valor} = ${3:valor}",
      "",
      "    def __str__(self) -> str:",
      "        return f\"${1:Nombre}({self.${3:valor}})\"$0"
    ],
    "description": "Clase con constructor"
  },
  "Clase de datos (dataclass)": {
    "prefix": "dataclass",
    "body": [
      "from dataclasses import dataclass",
      "",
      "",
      "@dataclass",
      "class ${1:Nombre}:",
      "    ${2:campo}: ${3:str}$0"
    ],
    "description": "Clase de datos (dataclass)"
  },
  "if / elif / else": {
    "prefix": "if",
    "body": [
      "if ${1:condición}:",
      "    ${2:pass}",
      "elif ${3:condición}:",
      "    ${4:pass}",
      "else:",
      "    ${0:pass}"
    ],
    "description": "if / elif / else"
  },
  "for sobre una colección": {
    "prefix": "for",
    "body": [
      "for ${1:elemento} in ${2:coleccion}:",
      "    ${0:print(${1:elemento})}"
    ],
    "description": "for sobre una colección"
  },
  "for con índice (enumerate)": {
    "prefix": "fori",
    "body": [
      "for ${1:i}, ${2:elemento} in enumerate(${3:coleccion}):",
      "    ${0:print(${1:i}, ${2:elemento})}"
    ],
    "description": "for con índice (enumerate)"
  },
  "while": {
    "prefix": "while",
    "body": [
      "while ${1:condición}:",
      "    ${0:pass}"
    ],
    "description": "while"
  },
  "try / except / finally": {
    "prefix": "try",
    "body": [
      "try:",
      "    ${1:pass}",
      "except ${2:ValueError} as ${3:error}:",
      "    print(f\"Error: {${3:error}}\")",
      "finally:",
      "    ${0:pass}"
    ],
    "description": "try / except / finally"
  },
  "Pedir un número al usuario con validación": {
    "prefix": "input",
    "body": [
      "while True:",
      "    try:",
      "        ${1:numero} = ${2:int}(input(\"${3:Introduce un número}: \"))",
      "        break",
      "    except ValueError:",
      "        print(\"Valor no válido, prueba otra vez.\")$0"
    ],
    "description": "Pedir un número al usuario con validación"
  },
  "Leer un archivo de texto": {
    "prefix": "with",
    "body": [
      "with open(\"${1:archivo.txt}\", encoding=\"utf-8\") as ${2:f}:",
      "    for ${3:linea} in ${2:f}:",
      "        ${0:print(${3:linea}.rstrip())}"
    ],
    "description": "Leer un archivo de texto"
  },
  "Escribir un archivo de texto": {
    "prefix": "withw",
    "body": [
      "with open(\"${1:archivo.txt}\", \"w\", encoding=\"utf-8\") as ${2:f}:",
      "    ${2:f}.write(${0:\"texto\\n\"})"
    ],
    "description": "Escribir un archivo de texto"
  },
  "Lista por comprensión": {
    "prefix": "lc",
    "body": [
      "[${1:x} for ${1:x} in ${2:coleccion} if ${3:condición}]$0"
    ],
    "description": "Lista por comprensión"
  },
  "Diccionario por comprensión": {
    "prefix": "dc",
    "body": [
      "{${1:k}: ${2:v} for ${1:k}, ${2:v} in ${3:dic}.items()}$0"
    ],
    "description": "Diccionario por comprensión"
  },
  "Leer un archivo JSON": {
    "prefix": "json",
    "body": [
      "import json",
      "",
      "with open(\"${1:datos.json}\", encoding=\"utf-8\") as ${2:f}:",
      "    ${3:datos} = json.load(${2:f})$0"
    ],
    "description": "Leer un archivo JSON"
  },
  "Argumentos de línea de órdenes (argparse)": {
    "prefix": "args",
    "body": [
      "import argparse",
      "",
      "parser = argparse.ArgumentParser(description=\"${1:Descripción}\")",
      "parser.add_argument(\"${2:fichero}\", help=\"${3:ayuda}\")",
      "parser.add_argument(\"-v\", \"--verbose\", action=\"store_true\")",
      "args = parser.parse_args()$0"
    ],
    "description": "Argumentos de línea de órdenes (argparse)"
  },
  "Ejecutar una orden del sistema (subprocess)": {
    "prefix": "sub",
    "body": [
      "import subprocess",
      "",
      "${1:resultado} = subprocess.run([${2:\"ls\", \"-l\"}], capture_output=True, text=True, check=True)",
      "print(${1:resultado}.stdout)$0"
    ],
    "description": "Ejecutar una orden del sistema (subprocess)"
  },
  "Test con pytest": {
    "prefix": "test",
    "body": [
      "def test_${1:nombre}() -> None:",
      "    assert ${2:funcion}(${3:entrada}) == ${0:esperado}"
    ],
    "description": "Test con pytest"
  }
}
